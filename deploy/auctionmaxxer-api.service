# The HTTP API. Listens on 127.0.0.1 only; Caddy is the public entrance.
#   journalctl -u auctionmaxxer-api -n 50

[Unit]
Description=auctionmaxxer HTTP API
After=network.target

[Service]
User=auction
WorkingDirectory=/opt/auctionmaxxer/server
ExecStart=/opt/auctionmaxxer/server/node_modules/.bin/tsx src/apiServer.ts
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
