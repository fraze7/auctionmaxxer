# The collector. systemd starts it at boot and restarts it after a crash.
#   systemctl status auctionmaxxer
#   journalctl -u auctionmaxxer -f

[Unit]
Description=auctionmaxxer auction house collector
# The collector calls Blizzard as soon as it starts.
After=network-online.target
Wants=network-online.target

[Service]
User=auction
WorkingDirectory=/opt/auctionmaxxer/server
# tsx directly, not via npm, so stop signals reach our code.
ExecStart=/opt/auctionmaxxer/server/node_modules/.bin/tsx src/scheduler.ts
Restart=always
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
