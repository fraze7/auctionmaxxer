# One database backup, started by auctionmaxxer-backup.timer.
#   systemctl start auctionmaxxer-backup      run one now

[Unit]
Description=auctionmaxxer database backup

[Service]
Type=oneshot
User=auction
WorkingDirectory=/opt/auctionmaxxer/server
ExecStart=/opt/auctionmaxxer/server/node_modules/.bin/tsx src/runBackup.ts
NoNewPrivileges=true
PrivateTmp=true
